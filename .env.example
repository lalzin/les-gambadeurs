# ------------------------------------------------------------------
# Formulaire de contact (Resend)
# ------------------------------------------------------------------
# 1. Créer un compte gratuit sur https://resend.com
# 2. Y vérifier le domaine lesgambadeurs.fr (Domains → Add Domain),
#    puis ajouter les enregistrements DNS proposés chez le registrar.
# 3. Générer une clé d'API (API Keys → Create).
# 4. Reporter ces variables sur Vercel : Settings → Environment Variables.
#
# En local, copier ce fichier en « .env.local » et y mettre les vraies valeurs.
# Sans RESEND_API_KEY, le formulaire affiche un message invitant à téléphoner
# ou à écrire directement : aucune demande n'est perdue silencieusement.

RESEND_API_KEY=

# Adresse qui reçoit les demandes (par défaut : contact@lesgambadeurs.fr)
CONTACT_TO=

# Expéditeur. Doit appartenir à un domaine vérifié dans Resend.
# Exemple : "Les Gambadeurs <site@lesgambadeurs.fr>"
CONTACT_FROM=
